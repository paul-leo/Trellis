{
  "name": "agent-trellis",
  "version": "0.8.0",
  "description": "A unified Code Agent Runtime for Skills, MCP, Memory, and shared instructions across Claude Code, Codex, Kiro, pi, and Kimi Code.",
  "license": "MIT",
  "author": "Paul Leo",
  "type": "module",
  "bin": {
    "trellis": "./dist/cli.js"
  },
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-pi-bridge.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-pi-bridge.mjs",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "verify-pack": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run verify-pack"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-leo/Trellis.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "kiro",
    "agent-skills",
    "agents.md"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typebox": "^1.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1"
  }
}
