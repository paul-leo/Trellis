{
  "name": "@trellis/evolve-engine",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript port of the harness2 (google-research) evolution engine. Stage 1: workspace-internal package, not published to npm.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check-deps": "node scripts/check-deps.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
