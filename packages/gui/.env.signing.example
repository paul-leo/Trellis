# macOS signing + notarization environment variables (template, safe to commit).
# Copy to .env.signing, fill in real values, then before building:
#   set -a; source .env.signing; set +a
#   npx tauri build
#
# Unsigned local build needs none of this.

# Signing identity name, exactly as it appears in the login keychain
# (`security find-identity -v -p codesigning`).
export APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"

# Notarization via an App Store Connect API key (recommended over the
# interactive Apple ID + app-specific-password flow):
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API
export APPLE_API_KEY="XXXXXXXXXX"          # the Key ID
export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
export APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"

# Alternative to the API key above — Apple ID + app-specific password
# (https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords):
# export APPLE_ID="your-apple-id@example.com"
# export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# export APPLE_TEAM_ID="XXXXXXXXXX"
