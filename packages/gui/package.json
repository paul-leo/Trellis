{
  "name": "@trellis/gui",
  "private": true,
  "version": "0.0.0",
  "description": "Trellis desktop GUI (Tauri v2 + React) — read-write control surface over the agent-trellis canonical source.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar:typecheck": "tsc --noEmit -p sidecar/tsconfig.json",
    "sidecar:test": "tsx --test \"sidecar/**/*.test.ts\"",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "test:smoke": "node --import tsx --experimental-loader ./src/testCssLoader.mjs --test src/App.smoke.test.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@yao-pkg/pkg": "^6.22.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
