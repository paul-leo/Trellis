<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required: Tauri's WebView (WKWebView's JS engine) needs JIT once
       hardened runtime is on, or the app crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The bundled sidecar embeds Node/V8 (pkg-compiled) — same JIT need. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Sidecar HTTP/WebSocket server (loopback only) and any outbound
       calls a configured MCP server or chat target makes. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
